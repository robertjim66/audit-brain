# ============================================================
# 审计智脑 AuditBrain 环境变量模板
# 复制为 .env 后填入真实值：cp .env.example .env
# 真实密钥绝不入库（已在 .gitignore 忽略）
# ============================================================

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ai_audit

# JWT 密钥（本地生成随机长字符串：openssl rand -base64 48）
JWT_SECRET=replace_with_a_long_random_string_generated_locally

# 服务端口
PORT=3003

# 运行环境：development / production
NODE_ENV=development

# 反向代理信任范围：loopback（Nginx 与 Node 同机）或代理 IP/网段
TRUST_PROXY=loopback

# CORS 白名单（同源部署通常留空；前后端分离部署时填前端来源，逗号分隔，支持 *.example.com 通配）
ALLOWED_ORIGINS=http://localhost:3003

# ============================================================
# 工程审计模块 — 外部 AI 能力
# ============================================================

# PaddleOCR-VL 官方在线 API（AI Studio）—— 审计资料的"眼睛"（文档识别/解析）
# Token 获取：https://aistudio.baidu.com/account/accessToken
OCR_KEY=
OCR_BASE_URL=https://paddleocr.aistudio-app.com
OCR_API_VERSION=v2
OCR_MODEL=PaddleOCR-VL-1.6
OCR_POLL_INTERVAL_MS=3000
OCR_TIMEOUT_MS=600000

# 火山方舟 Seed-2.1-pro（doubao-seed-evolving）—— 审计 Agent 大脑
# 控制台创建接入点：https://console.volcengine.com/ark
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=DeepSeek-V4.1-Flash
